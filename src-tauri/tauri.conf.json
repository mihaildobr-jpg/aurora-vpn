{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora VPN",
  "mainBinaryName": "aurora-vpn",
  "version": "1.0.0",
  "identifier": "app.aurora.vpn",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aurora VPN",
        "width": 1040,
        "height": 700,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sing-box"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "resources": {
      "binaries/libcronet.dll": "libcronet.dll"
    }
  }
}
